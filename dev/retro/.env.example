# dev/retro/.env.example — copy to dev/retro/.env if you want to override
# any of the defaults baked into docker-compose.yml. Compose reads .env from
# the directory of the -f compose file automatically.

# ─── MySQL ───────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=retro
MYSQL_USER=retro
MYSQL_PASSWORD=retro
MYSQL_HOST_PORT=3307

# ─── Arcturus emulator ───────────────────────────────────────────
GAME_PORT=30000
WEBSERVER_PORT=2400
CAMERA_URL=http://localhost:2400/camera/

# ─── Web services (host-side ports) ──────────────────────────────
CMS_PORT=8088
NITRO_PORT=8089
ASSETS_PORT=8090

# ─── URLs (handed to the CMS / Nitro / your front-end) ───────────
HOTEL_URL=http://localhost:8088
NITRO_URL=http://localhost:8089
ASSETS_URL=http://localhost:8090
EMULATOR_HOST=127.0.0.1
EMULATOR_PORT=30000
