# NOTE: .gitignore does NOT support trailing inline comments — `pattern  # foo`
# silently includes the spaces + "# foo" in the pattern and matches nothing.
# Keep every comment on its own line.

# ── Dependencies ─────────────────────────────────────────────────
node_modules
.pnp
.pnp.js

# ── Build outputs ────────────────────────────────────────────────
dist
build
out
tmp
*.tsbuildinfo

# ── Nx caches ────────────────────────────────────────────────────
.nx/cache
.nx/workspace-data

# ── Logs ─────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Environment / secrets (NEVER commit) ─────────────────────────
.env
.env.local
.env.*.local

# ── Editor / IDE / OS ────────────────────────────────────────────
# Most VS Code state is user-specific; allow-list the shared bits below.
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
.idea
.DS_Store
Thumbs.db

# ── Test / coverage artifacts ────────────────────────────────────
coverage
.nyc_output
**/cypress/screenshots
**/cypress/videos
**/cypress/downloads

# ── Lint / format caches ─────────────────────────────────────────
.eslintcache
.prettiercache

# ── Vendored / cloned upstream source (Holo5 submodules, build cache) ─
# These directories hold third-party source we clone for the Retro stack.
# They are NOT part of our git history — anyone who needs them runs the
# documented bootstrap scripts to recreate them.
**/.build/
dev/retro/emulator/arcturus/
dev/retro/nitro/nitro-react/
dev/retro/nitro/nitro-converter/
dev/retro/nitro/nitro-assets/
dev/retro/nitro/nitro-swf/

# ── Public CDN runtime artefacts ─────────────────────────────────
# Generated by retro:assets:extract; never committed to git.
public/retro/
public/uploads/*
!public/uploads/.gitkeep
public/.gitignore.bak

# ── Service build outputs ────────────────────────────────────────
services/cdn/dist/
