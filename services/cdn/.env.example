# services/cdn/.env.example — copy to .env (or rely on the workspace-root .env).
#
# The CDN serves the repo's public/ directory with strict security headers
# and a cloud-CDN push pipeline (rclone) for production.

# ─── Local server ────────────────────────────────────────────────
CDN_HOST=0.0.0.0
CDN_PORT=5500
CDN_PUBLIC_DIR=public                # path relative to repo root
CDN_LOG_LEVEL=info                   # trace | debug | info | warn | error | fatal | silent
CDN_ALLOW_LISTING=true               # dev only — turn OFF in prod
CDN_TRUST_PROXY=false                # set true when behind nginx/Caddy/CF

# ─── Security ────────────────────────────────────────────────────
CDN_CORS_ORIGINS=*                   # comma-separated origins, "*" or "false"
CDN_RATE_LIMIT_MAX=200               # requests per window per IP
CDN_RATE_LIMIT_WINDOW_MS=60000       # 60s

# ─── Push to a cloud CDN (npm run cdn:push) ──────────────────────
# Pick ONE provider and fill in its credentials. The push script uses
# rclone under the hood; any rclone-supported backend works.
#
# Provider keys (informational only):
#   aws-s3            — S3 + optional CloudFront invalidation
#   cloudflare-r2     — R2 (S3-compatible)
#   bunny-storage     — BunnyCDN Storage Zone
#   gcs               — Google Cloud Storage
#   azure-blob        — Azure Blob Storage
CDN_PROVIDER=cloudflare-r2
CDN_BUCKET=ghostnet-prod-public
CDN_REMOTE_PREFIX=                   # optional sub-path inside the bucket

# AWS S3 / Cloudflare R2 (S3-compatible)
S3_ENDPOINT=                         # e.g. https://<account>.r2.cloudflarestorage.com
S3_REGION=auto                       # `auto` for R2, e.g. us-east-1 for AWS
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional: invalidate after push (CloudFront / Cloudflare zone)
CDN_INVALIDATION_ID=                 # CloudFront distribution ID, blank to skip
CLOUDFLARE_ZONE_ID=                  # zone ID for cache purge, blank to skip
CLOUDFLARE_API_TOKEN=
