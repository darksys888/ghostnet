{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": ["ES2022"],
    "types": ["node"],
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "isolatedModules": true,
    "noUnusedLocals": false,
    "composite": false
  },
  "include": ["src/**/*.ts"]
}
