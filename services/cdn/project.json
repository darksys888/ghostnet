{
  "name": "cdn",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/cdn/src",
  "projectType": "application",
  "tags": ["scope:workspace", "type:service"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/cdn",
        "command": "tsc -p tsconfig.app.json"
      },
      "outputs": ["{projectRoot}/dist"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/cdn",
        "command": "tsx watch src/index.ts"
      },
      "continuous": true
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/cdn",
        "command": "node dist/index.js"
      },
      "dependsOn": ["build"],
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "services/cdn",
        "command": "tsc --noEmit -p tsconfig.app.json"
      }
    }
  }
}
