# deploy/retro/.env.example — copy to deploy/retro/.env and customise.
# .env is gitignored; never commit real production secrets here.
#
# Used by: deploy/retro/docker-compose.yaml (compose --env-file)
# Documented in: package.json.md → "Retro production deployment".

# ─── Image versioning ────────────────────────────────────────────
RETRO_VERSION=0.1.0

# ─── MariaDB ─────────────────────────────────────────────────────
# These ALSO seed the DB on first boot — change them BEFORE the first
# `retro:deploy:up`, otherwise wipe the volume and re-seed.
MYSQL_ROOT_PASSWORD=replace-me-with-a-real-root-pw
MYSQL_DATABASE=arcturus
MYSQL_USER=arcturus_user
MYSQL_PASSWORD=replace-me-with-a-real-app-pw

# ─── Bound host ports (loopback only — front with nginx/Caddy) ───
# These bind to 127.0.0.1 in the compose file. A reverse proxy on
# the host terminates TLS and forwards to these ports.
MYSQL_PORT=3306
ARCTURUS_GAME_PORT=3000
ARCTURUS_RCON_PORT=3001
ARCTURUS_WEBSOCKET_PORT=2096
NITRO_PORT=1080
ASSETS_PORT=8080
