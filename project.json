{
  "name": "ghostnet",
  "$schema": "./node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "root": ".",
  "sourceRoot": ".",
  "tags": ["scope:workspace", "type:root"],
  "implicitDependencies": [],
  "targets": {
    "check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run check"
      },
      "metadata": {
        "description": "Full workspace quality gate (format-check + lint + typecheck + test)."
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --max-warnings=0"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/eslint.config.mjs"],
      "metadata": {
        "description": "Workspace-wide ESLint with zero-warnings enforced."
      }
    },
    "lint-fix": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint . --fix"
      },
      "metadata": {
        "description": "Workspace-wide ESLint with --fix."
      }
    },
    "format": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run format"
      },
      "metadata": {
        "description": "Run Prettier --write across the workspace."
      }
    },
    "format-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run format:check"
      },
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/.prettierrc.cjs", "{workspaceRoot}/.prettierignore"],
      "metadata": {
        "description": "Run Prettier --check (CI-friendly, no writes)."
      }
    },
    "docker-check": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --target check -t ghostnet/ci ."
      },
      "metadata": {
        "description": "Run the full quality gate inside Docker (CI parity)."
      }
    },
    "docker-build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "docker build --target build -t ghostnet/build ."
      },
      "metadata": {
        "description": "Run the Nx build inside Docker."
      }
    },
    "graph": {
      "executor": "nx:run-commands",
      "options": {
        "command": "nx graph"
      },
      "metadata": {
        "description": "Open the interactive Nx project-graph viewer."
      }
    }
  }
}
