{
  "name": "coming-soon",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/coming-soon/src",
  "projectType": "application",
  "tags": ["scope:apps", "type:app"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/coming-soon",
        "command": "next build"
      },
      "outputs": ["{projectRoot}/.next", "!{projectRoot}/.next/cache"],
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/coming-soon",
        "command": "next dev -p 4000"
      },
      "continuous": true
    },
    "start": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/coming-soon",
        "command": "next start -p 4000"
      },
      "dependsOn": ["build"],
      "continuous": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/coming-soon",
        "command": "tsc --noEmit"
      }
    }
  }
}
