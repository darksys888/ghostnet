# .env.example — template for local development env vars.
# Copy to apps/<app-name>/.env (or whatever location each app expects).
# Values match the services started by .devcontainer/docker-compose.yml,
# so anything reading from these vars Just Works inside the dev container.

# ─── Runtime ─────────────────────────────────────────────────────
NODE_ENV=development

# ─── PostgreSQL ──────────────────────────────────────────────────
# Hostname `postgres` resolves inside the compose network.
# Use `localhost:5432` when connecting from the host machine.
DATABASE_URL=postgres://ghostnet:ghostnet@postgres:5432/ghostnet

# ─── MySQL (Retro / Habbo emulator) ──────────────────────────────
# Single-URL form (ORMs, Prisma, libraries that take a DSN):
RETRO_DB_URL=mysql://retro:retro@mysql:3306/retro
# Discrete fields (Arcturus / Plus EMU config.ini, etc.):
RETRO_DB_HOST=mysql
RETRO_DB_PORT=3306
RETRO_DB_NAME=retro
RETRO_DB_USER=retro
RETRO_DB_PASSWORD=retro

# ─── Redis ───────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Mailpit (SMTP catcher) ──────────────────────────────────────
# All outgoing mail is captured — read it at http://localhost:8025
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM="GHOSTNET dev <noreply@ghostnet.local>"

# ─── MinIO (S3-compatible object storage) ────────────────────────
# Console: http://localhost:9001  (login: minioadmin / minioadmin)
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ghostnet-dev
S3_FORCE_PATH_STYLE=true

# ─── App-specific (extend as needed) ─────────────────────────────
# JWT_SECRET=replace-me-in-real-envs
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
