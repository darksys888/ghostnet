# Repo-wide line-ending + binary handling.
# Authoritative — supersedes any per-subdirectory .gitattributes.
#
# Why this matters: Git on Windows has `core.autocrlf = true` by default,
# which silently rewrites LF → CRLF on checkout. That breaks every shell
# script the moment it runs inside a Linux container, and it makes diffs
# spurious for collaborators on Linux/macOS. This file pins the answer.

# ── Default: detect text vs binary, force LF for text ────────────
* text=auto eol=lf

# ── Force LF on Linux-side scripts and configs ───────────────────
*.sh         text eol=lf
*.bash       text eol=lf
*.zsh        text eol=lf
*.fish       text eol=lf
*.conf       text eol=lf
*.ini        text eol=lf
Dockerfile   text eol=lf
*.dockerfile text eol=lf
.dockerignore text eol=lf
Makefile     text eol=lf
*.mk         text eol=lf

# ── Force CRLF on Windows-only files ─────────────────────────────
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# ── YAML / JSON / TOML — text + LF (Prettier formats them anyway) ─
*.yml        text eol=lf
*.yaml       text eol=lf
*.toml       text eol=lf
*.json       text eol=lf
*.jsonc      text eol=lf

# ── Code files — text + LF ───────────────────────────────────────
*.js         text eol=lf
*.cjs        text eol=lf
*.mjs        text eol=lf
*.jsx        text eol=lf
*.ts         text eol=lf
*.tsx        text eol=lf
*.cts        text eol=lf
*.mts        text eol=lf
*.css        text eol=lf
*.scss       text eol=lf
*.html       text eol=lf
*.md         text eol=lf
*.markdown   text eol=lf
*.txt        text eol=lf
*.sql        text eol=lf

# ── Binary safeguards (never diff as text) ───────────────────────
*.png        binary
*.jpg        binary
*.jpeg       binary
*.gif        binary
*.ico        binary
*.bmp        binary
*.webp       binary
*.woff       binary
*.woff2      binary
*.ttf        binary
*.eot        binary
*.otf        binary
*.zip        binary
*.tar        binary
*.tgz        binary
*.gz         binary
*.7z         binary
*.bz2        binary
*.jar        binary
*.war        binary
*.so         binary
*.dll        binary
*.exe        binary
*.dylib      binary
*.swf        binary
*.nitro      binary
*.mp3        binary
*.mp4        binary
*.ogg        binary
*.wav        binary
*.webm       binary
*.pdf        binary
*.psd        binary
*.ai         binary
*.sketch     binary
*.fig        binary

# SVGs are XML — keep them as text so diffs are useful.
*.svg        text eol=lf

# ── Generated lockfiles — collapse from diffs / GitHub PR view ───
package-lock.json -diff linguist-generated
yarn.lock         -diff linguist-generated
pnpm-lock.yaml    -diff linguist-generated

