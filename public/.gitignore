# public/ — workspace-wide static asset CDN root.
# Ignore generated content; commit only the directory markers + intentional
# shared assets (logos, default fonts, templates, etc.).

# Generated by `npm run retro:assets:extract` — never committed.
/retro/

# User uploads — content lives at runtime, not in source.
/uploads/*
!/uploads/.gitkeep

# Always allow .gitkeep markers so empty subdirs stay tracked.
!**/.gitkeep
